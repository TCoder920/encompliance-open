[run]
source = app
omit = 
    */tests/*
    */venv/*
    */__pycache__/*
    app/main.py
    app/admin_main.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError
    def setup_logging    
    
[html]
directory = htmlcov 