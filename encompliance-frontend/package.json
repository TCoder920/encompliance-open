{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.user.ts",
    "dev-support": "vite --config vite.config.support.ts",
    "build": "vite build --config vite.config.user.ts && vite build --config vite.config.support.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:a11y": "jest --testPathPattern=.*\\.a11y\\.spec\\.tsx?$",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "cypress:a11y": "cypress run --spec \"cypress/e2e/accessibility.cy.ts\"",
    "cypress:responsive": "cypress run --spec \"cypress/e2e/responsive.cy.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fullcalendar/core": "^6.1.11",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.17",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@sentry/react": "^9.13.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/types": "^12.0.0",
    "@simplewebauthn/typescript-types": "^8.3.4",
    "@types/moment": "^2.11.29",
    "@types/react-big-calendar": "^1.16.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/recharts": "^1.8.29",
    "autoprefixer": "10.4.21",
    "axios": "^1.8.2",
    "caniuse-lite": "^1.0.30001705",
    "lucide-react": "^0.344.0",
    "moment": "^2.30.1",
    "openai": "^4.28.0",
    "postcss": "^8.5.31",
    "react": "^18.3.0",
    "react-big-calendar": "^1.19.3",
    "react-d3-tree": "^3.6.2",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-tooltip": "^5.28.1",
    "reactflow": "11.11.4",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "3.4.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
